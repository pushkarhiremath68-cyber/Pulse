{
  "name": "pulse-music-app",
  "productName": "Pulse Music",
  "version": "2.4.0",
  "description": "Pulse Music - High-Fidelity Cross-Platform Music Streaming App by Pushkar Hiremath",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "Pushkar Hiremath",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:icons": "python scripts/generate_all_app_icons.py",
    "build:certs": "python scripts/generate_certificates.py",
    "build:packages": "python scripts/build_release_packages.py",
    "build:all": "npm run build:icons && npm run build:certs && npm run build:packages",
    "dist:win": "npm run build && python scripts/build_release_packages.py",
    "dist:mac": "npm run build && python scripts/build_release_packages.py",
    "dist:linux": "npm run build && python scripts/build_release_packages.py",
    "dist:android": "npm run build && python scripts/build_valid_android_apk.py",
    "test:auth": "python scripts/test_auth_api.py",
    "test:download": "python scripts/test_download_api.py"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/cli": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@capacitor/ios": "6.2.0",
    "jsdom": "^27.0.1",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "firebase": "^12.17.1"
  }
}
